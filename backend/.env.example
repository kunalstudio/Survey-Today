# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB - Use production database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/surveydb?retryWrites=true&w=majority

# JWT - Generate secure random strings for production
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d

# Frontend URL (for CORS) - Update with your Vercel URL
CLIENT_URL=https://your-app.vercel.app

# Email Configuration (Optional - for password reset emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Survey Today <noreply@surveytoday.com>
